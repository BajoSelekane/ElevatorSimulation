name: Elevator Simulation CI

on:
  push:
    branches:
      - master
      - develop
      - 'feature/**'
  pull_request:
    branches:
      - master
      - develop
  workflow_dispatch:

permissions:
  contents: read

env:
  DOTNET_VERSION: '10.0.x'
  SOLUTION: 'ElevatorSimulation.slnx'
  CONFIGURATION: 'Release'

jobs:
  restore-build-test:
    name: Restore, Build & xUnit Tests
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: ${{ env.DOTNET_VERSION }}
          cache: true
          cache-dependency-path: '**/packages.lock.json'

      - name: Verify solution
        shell: bash
        run: |
          set -euo pipefail

          if [[ ! -f "${SOLUTION}" ]]; then
            echo "::error::Solution file '${SOLUTION}' was not found."
            echo "Available solution/project files:"
            find . -maxdepth 4 \( -name '*.sln' -o -name '*.slnx' -o -name '*.csproj' \) -print
            exit 1
          fi

          echo "Using solution: ${SOLUTION}"

      - name: Restore solution
        run: dotnet restore "${{ env.SOLUTION }}"

      - name: Build solution
        run: dotnet build "${{ env.SOLUTION }}" --configuration "${{ env.CONFIGURATION }}" --no-restore

      - name: Run xUnit tests
        run: |
          dotnet test "${{ env.SOLUTION }}"             --configuration "${{ env.CONFIGURATION }}"             --no-build             --no-restore             --verbosity normal             --logger "trx;LogFileName=test-results.trx"             --results-directory ./TestResults

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: xunit-test-results
          path: ./TestResults
          if-no-files-found: warn
          retention-days: 14
